VITE_API_BASE_URL=http://localhost:8090

# Optional override for the live-collaboration WebSocket origin. By default
# it's derived from VITE_API_BASE_URL (http(s) -> ws(s)), which is correct in
# both dev and prod. Only set this if the WS endpoint lives on a different
# host/port than the REST API.
# VITE_WS_BASE_URL=wss://your-ws-host
